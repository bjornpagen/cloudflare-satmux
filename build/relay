#!/bin/sh
# Builds the relay Worker into build/out/relay: index.js (the ES-module entry), index_bg.wasm
# (the CompiledWasm module it imports) and build-id. See build/README.md.
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")
tools=$here/tools
out=$here/out/relay
crate=$root/crates/satmux-relay

if [ ! -x "$tools/bin/worker-build" ]; then
  CARGO_TARGET_DIR="$tools/target" cargo install --locked worker-build --version 0.8.7 --root "$tools"
fi

(cd "$crate" && "$tools/bin/worker-build" --release)

rm -rf "$out"
mkdir -p "$out"
cp "$crate/build/index.js" "$crate/build/index_bg.wasm" "$out/"
if id=$(git -C "$root" rev-parse HEAD 2>/dev/null); then
  printf '%s\n' "$id" > "$out/build-id"
else
  printf 'dev\n' > "$out/build-id"
fi
ls -l "$out"
